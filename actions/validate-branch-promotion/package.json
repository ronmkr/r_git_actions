{
  "name": "validate-branch-promotion",
  "version": "1.0.0",
  "description": "GitHub Action to enforce branch merge promotion policies (e.g. GitFlow develop -> main, GitOps dev -> uat -> prd).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run test && npm run bundle"
  },
  "keywords": [
    "actions",
    "github",
    "branch-promotion",
    "gitflow",
    "gitops",
    "code-governance"
  ],
  "author": "ronmkr",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "@vercel/ncc": "^0.38.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
