{
  "name": "validate-commit",
  "version": "1.0.0",
  "description": "GitHub Action to validate commit messages for Jira ticket keys (regex), Jira issue status, and Conventional Commits.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run build && npm run test && npm run bundle"
  },
  "keywords": [
    "actions",
    "github",
    "jira",
    "commit-lint",
    "conventional-commits"
  ],
  "author": "ronmkr",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "@vercel/ncc": "^0.38.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^7.0.2"
  }
}
