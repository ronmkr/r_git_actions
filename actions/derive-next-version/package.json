{
  "name": "derive-next-version",
  "version": "1.0.0",
  "description": "Automates release versioning by combining Conventional Commits and Semantic Versioning (SemVer 2.0).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run test && npm run bundle"
  },
  "keywords": [
    "actions",
    "github",
    "semver",
    "conventional-commits",
    "versioning"
  ],
  "author": "ronmkr",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "@vercel/ncc": "^0.45.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "undici": ">=6.27.1"
  }
}
