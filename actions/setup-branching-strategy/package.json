{
  "name": "setup-branching-strategy",
  "version": "1.0.0",
  "description": "GitHub Action to create, configure, and protect branches for GitFlow, Trunk-Based, GitOps, or custom branching models.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run test && npm run bundle"
  },
  "keywords": [
    "actions",
    "github",
    "branching-strategy",
    "gitflow",
    "trunk-based",
    "gitops",
    "branch-protection"
  ],
  "author": "ronmkr",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "@vercel/ncc": "^0.38.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
