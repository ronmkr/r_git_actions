{
  "name": "prevent-committer-approval",
  "version": "1.0.0",
  "description": "GitHub Action that prohibits PR committers from approving the PR, automatically dismissing non-compliant approvals.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run test && npm run bundle"
  },
  "keywords": [
    "actions",
    "github",
    "pull-request",
    "code-review",
    "governance",
    "compliance"
  ],
  "author": "ronmkr",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "@vercel/ncc": "^0.45.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
